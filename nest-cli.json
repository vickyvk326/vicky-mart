{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [],
    "builder": "swc",
    "typeCheck": true
  },
  "watchOptions": {
    "ignored": ["**/metadata.ts", "dist", "node_modules", "logs", "test"]
  }
}
